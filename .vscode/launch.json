{
    "version": "0.2.0",
    "configurations": [
      {
        "name": "Debug (GDB)",
        "type": "cppdbg",
        "request": "launch",
        "program": "${workspaceFolder}/HW2/hw2", // Executable file to debug
        "args": [],
        "stopAtEntry": false,
        "cwd": "${workspaceFolder}",
        "environment": [],
        "externalConsole": false,
        "MIMode": "gdb",
        "setupCommands": [
          {
            "description": "Enable pretty-printing for gdb",
            "text": "-enable-pretty-printing",
            "ignoreFailures": true
          }
        ],
        "miDebuggerPath": "/usr/bin/gdb",
        "preLaunchTask": "build", // Runs the build task before debugging
        "visualizerFile": "${workspaceFolder}/.vscode/gdb-visualizers",
        "logging": {
          "moduleLoad": false,
          "trace": false
        }
      }
    ]
  }
  